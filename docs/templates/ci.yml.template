name: SSZ P5 CI
on:
  pull_request:
  push:
    branches: [main]

jobs:
  fast:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: '3.11'}
      - run: python -m pip install -e '.[dev]'
      - run: ruff check .
      - run: pytest -q tests/unit tests/negative tests/regression
      - run: python ssz_p5_full_closure_auditor.py --data-dir . --quick --manifest MANIFEST.json

  full:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: '3.11'}
      - run: python -m pip install -e '.[dev]'
      - run: pytest -q
      - run: python ssz_p5_full_closure_auditor.py --data-dir . --full --manifest MANIFEST.json
      # Enable these three only after D4 is implemented:
      # - run: ssz-p5 build coefficients --output data/generated/global41.parquet
      # - run: ssz-p5 build krgm --L 6 12 20 42 110 420 1000 --output-dir data/generated/krgm
      # - run: ssz-p5 export certificate --output data/certificates/SSZ_P5_DIRECT_GLOBAL_KRGM_CERTIFICATE.json
      # - run: python ssz_p5_full_closure_auditor.py --data-dir . --require-direct-krgm
