[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[project]
name = "ssz-p5"
version = "0.1.0"
description = "Reproducible SSZ P5 Horndeski + U(1)-SVT closure and perturbation pipeline"
requires-python = ">=3.11"
dependencies = [
  "numpy>=1.26,<3",
  "pandas>=2.0,<4",
  "scipy>=1.11,<2",
  "matplotlib>=3.8,<4",
  "jsonschema>=4.22,<5",
]

[project.optional-dependencies]
dev = ["pytest>=8,<10", "pytest-cov>=5,<8", "ruff>=0.6,<1", "mypy>=1.11,<2"]

[project.scripts]
ssz-p5 = "ssz_p5.cli:main"

[tool.pytest.ini_options]
addopts = "-ra --strict-markers"
testpaths = ["tests"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E","F","I","UP","B"]
